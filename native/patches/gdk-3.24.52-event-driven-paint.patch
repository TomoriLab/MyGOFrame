--- a/gdk/gdkframeclockidle.c
+++ b/gdk/gdkframeclockidle.c
@@ -672,6 +672,26 @@
   GdkFrameClockIdle *clock_idle = GDK_FRAME_CLOCK_IDLE (clock);
   GdkFrameClockIdlePrivate *priv = clock_idle->priv;
 
+  /* External damage must not sample a live video source on an unrelated timer.
+   * Animation ticks and requests made while painting retain normal pacing. */
+  if (priv->freeze_count == 0 && priv->updating_count == 0 &&
+      !priv->in_paint_idle && (phase & GDK_FRAME_CLOCK_PHASE_PAINT) &&
+      g_strcmp0 (g_getenv ("MYGO_GDK_EVENT_DRIVEN_PAINT"), "1") == 0)
+    {
+      priv->min_next_frame_time = 0;
+      /* Both sources retain their priorities when an old deadline is retired. */
+      if (priv->flush_idle_id != 0)
+        {
+          g_source_remove (priv->flush_idle_id);
+          priv->flush_idle_id = 0;
+        }
+      if (priv->paint_idle_id != 0)
+        {
+          g_source_remove (priv->paint_idle_id);
+          priv->paint_idle_id = 0;
+        }
+    }
+
   priv->requested |= phase;
   maybe_start_idle (clock_idle, FALSE);
 }
