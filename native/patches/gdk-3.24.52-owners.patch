+void
+_gdk_wayland_seat_close_native (GdkSeat *base)
+{
+  GdkWaylandSeat *seat = GDK_WAYLAND_SEAT (base);
+  GdkWaylandDisplay *display;
+
+  if (seat->native_closed)
+    return;
+  seat->native_closed = TRUE;
+  g_object_ref (base);
+  if (!seat->display || !seat->device_manager)
+    {
+      g_object_unref (base);
+      return;
+    }
+  display = GDK_WAYLAND_DISPLAY (seat->display);
+
+  /* Native resources retire while their display and manager still exist. */
+  stop_key_repeat (seat);
+  gdk_wayland_pointer_stop_cursor_animation (&seat->pointer_info);
+  gdk_wayland_pointer_stop_cursor_animation (&seat->touch_info);
+  {
+    GList *link;
+    for (link = seat->tablets; link; link = link->next)
+      {
+        GdkWaylandTabletData *tablet = link->data;
+        gdk_wayland_pointer_stop_cursor_animation (&tablet->pointer_info);
+      }
+  }
+  g_signal_handlers_disconnect_by_data (display->screen, seat);
+  gdk_wayland_seat_set_grab_window (seat, NULL);
+  g_clear_object (&seat->grab_cursor);
+  g_clear_object (&seat->cursor);
+  g_clear_object (&seat->keyboard_focus);
+
+  while (seat->tablet_tools)
+    _gdk_wayland_seat_remove_tool (seat, seat->tablet_tools->data);
+  while (seat->tablets)
+    _gdk_wayland_seat_remove_tablet (seat, seat->tablets->data);
+  while (seat->tablet_pads)
+    _gdk_wayland_seat_remove_tablet_pad (seat, seat->tablet_pads->data);
+
+  g_clear_pointer (&seat->wp_pointer_gesture_swipe, zwp_pointer_gesture_swipe_v1_destroy);
+  g_clear_pointer (&seat->wp_pointer_gesture_pinch, zwp_pointer_gesture_pinch_v1_destroy);
+  seat_handle_capabilities (seat, seat->wl_seat, 0);
+  g_clear_object (&seat->drop_context);
+  gdk_wayland_seat_remove_device (seat, &seat->master_pointer);
+  gdk_wayland_seat_remove_device (seat, &seat->master_keyboard);
+  gdk_wayland_pointer_data_finalize (&seat->pointer_info);
+  gdk_wayland_pointer_data_finalize (&seat->touch_info);
+  g_clear_object (&seat->keyboard_settings);
+  if (seat->touches)
+    g_hash_table_remove_all (seat->touches);
+  if (seat->foreign_dnd_window)
+    {
+      GdkWindow *window = g_steal_pointer (&seat->foreign_dnd_window);
+      gdk_window_destroy (window);
+    }
+
+  g_clear_pointer (&seat->gtk_primary_data_device, gtk_primary_selection_device_destroy);
+  g_clear_pointer (&seat->zwp_primary_data_device_v1, zwp_primary_selection_device_v1_destroy);
+  g_clear_pointer (&seat->wp_tablet_seat, zwp_tablet_seat_v2_destroy);
+  if (seat->data_device)
+    {
+      if (wl_data_device_get_version (seat->data_device) >= WL_DATA_DEVICE_RELEASE_SINCE_VERSION)
+        wl_data_device_release (seat->data_device);
+      else
+        wl_data_device_destroy (seat->data_device);
+      seat->data_device = NULL;
+    }
+  if (seat->wl_seat)
+    {
+      if (wl_seat_get_version (seat->wl_seat) >= WL_SEAT_RELEASE_SINCE_VERSION)
+        wl_seat_release (seat->wl_seat);
+      else
+        wl_seat_destroy (seat->wl_seat);
+      seat->wl_seat = NULL;
+    }
+  g_signal_handlers_disconnect_by_data (seat->device_manager, seat);
+  seat->device_manager = NULL;
+  seat->display = NULL;
+  g_object_unref (base);
+}
