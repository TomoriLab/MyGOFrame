+func requireReleased(t *testing.T, ledger *variantLedger, count int) {
+	t.Helper()
+	if ledger.created != count || ledger.freed != count || len(ledger.live) != 0 {
+		t.Fatalf("type ownership created=%d freed=%d live=%v", ledger.created, ledger.freed, ledger.live)
+	}
+}
