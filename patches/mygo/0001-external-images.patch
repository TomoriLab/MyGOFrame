+
+func (provider *externalTestImage) Texture(contextID uint64) uint32 {
+	if currentContext() != provider.context {
+		panic("external image prepared without its context current")
+	}
+	provider.contextID = contextID
+	provider.prepared++
+	if provider.texture == 0 {
+		provider.texture = newTexture(glRGBA8, glRGBA, 2, 2, []byte{
+			255, 255, 255, 255, 255, 255, 255, 255,
+			255, 255, 255, 255, 255, 255, 255, 255,
+		}, 8)
+	}
+	return provider.texture
+}
+
+func (provider *externalTestImage) Release(contextID uint64) {
+	if currentContext() != provider.context || contextID != provider.contextID {
+		panic("external image released without its context current")
+	}
+	provider.released++
+	if provider.texture != 0 {
+		glDeleteTextures(1, &provider.texture)
+		provider.texture = 0
+	}
+}
+
+func (provider *externalTestImage) Abandon(contextID uint64) {
+	provider.abandoned++
+	provider.texture = 0
+}
+
+func TestExternalImageRendersAndRetiresInItsContext(t *testing.T) {
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	offscreen, err := NewOffscreen(true, 16, 16)
+	if err != nil {
+		t.Skip(err)
+	}
+	defer offscreen.Release()
+	renderer, err := New()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer renderer.Release()
+	EnableExternalImages()
+	provider := &externalTestImage{context: currentContext()}
+	image := scene.NewExternalImage(2, 2, provider)
+	ready := 0
+	image.GPUReady = func(contextID uint64) {
+		if provider.prepared == 0 || contextID != provider.contextID || currentContext() != provider.context {
+			t.Error("GPU-ready callback ran before texture preparation or outside its context")
+		}
+		ready++
+	}
+	frame := &scene.Scene{Width: 16, Height: 16, Scale: 1, Ops: []scene.Op{{Kind: scene.OpImage, Rect: scene.Rect{W: 16, H: 16}, Src: scene.Rect{W: 2, H: 2}, Image: image}}}
+	if err := renderer.Render(frame); err != nil {
+		t.Fatal(err)
+	}
+	pixels, err := ReadFramebuffer(16, 16)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for index, value := range pixels {
+		if value != 255 {
+			t.Fatalf("external image pixel byte %d = %d, want 255", index, value)
+		}
+	}
+	if ready != 1 || provider.prepared != 1 || provider.contextID == 0 {
+		t.Fatalf("unexpected preparation counts: prepared=%d ready=%d context=%d", provider.prepared, ready, provider.contextID)
+	}
+	image.External = nil
+	frame.Ops = nil
+	if err := renderer.Render(frame); err != nil {
+		t.Fatal(err)
+	}
+	if provider.released != 1 || provider.abandoned != 0 {
+		t.Fatalf("retirement: released=%d abandoned=%d", provider.released, provider.abandoned)
+	}
+	renderer.Release()
+	if provider.released != 1 {
+		t.Fatal("external image released more than once")
+	}
+}
+
+func TestExternalImageContextLossUsesAbandon(t *testing.T) {
+	provider := &externalTestImage{}
+	image := scene.NewExternalImage(2, 2, provider)
+	renderer := &Renderer{externalContextID: 73, externalImages: map[uint64]externalTexture{}}
+	renderer.externalImages[image.ID()] = externalTexture{provider: provider}
+	renderer.abandonExternalImages()
+	renderer.abandonExternalImages()
+	if provider.abandoned != 1 || provider.released != 0 || len(renderer.externalImages) != 0 {
+		t.Fatalf("lost context cleanup: released=%d abandoned=%d", provider.released, provider.abandoned)
+	}
+}
