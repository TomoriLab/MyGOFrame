+func TestExternalBitmapSkipsCPUDownsamplingAndRetiresOnUpdate(t *testing.T) {
+	provider := &bitmapExternalTestImage{}
+	bitmap := NewExternalBitmap(3840, 2160, provider)
+	original := bitmap.img
+	if selected := bitmap.smaller(12); selected != original || len(bitmap.levels) != 0 || selected.Pix != nil {
+		t.Fatal("external bitmap allocated CPU downsample pixels")
+	}
+	version := original.Version()
+	bitmap.InvalidateExternal()
+	if original.Version() == version {
+		t.Fatal("external update did not invalidate image damage")
+	}
+	var readyContext uint64
+	bitmap.SetGPUReadyCallback(func(contextID uint64) { readyContext = contextID })
+	bitmap.Update(image.NewRGBA(image.Rect(0, 0, 4, 4)))
+	if original.External != nil || bitmap.img.External != nil || bitmap.img == original {
+		t.Fatal("CPU fallback retained the external provider")
+	}
+	selected := bitmap.smaller(2)
+	if selected.GPUReady == nil {
+		t.Fatal("CPU fallback's downsampled image lost the GPU-ready callback")
+	}
+	selected.GPUReady(19)
+	if readyContext != 19 {
+		t.Fatal("CPU fallback did not preserve GPU-ready instrumentation")
+	}
+}
