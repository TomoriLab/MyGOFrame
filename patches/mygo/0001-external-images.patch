+func TestNativeFontsShutdownOwnsEachReference(t *testing.T) {
+	var fonts nativeFonts
+	first, second := &Font{native: 7}, &Font{native: 7}
+	fonts.own(first)
+	fonts.own(second)
+	var pending []*ownedFont
+	for font := range fonts.dead.owned {
+		pending = append(pending, font)
+	}
+	released := 0
+	fonts.closeFonts(func(native uintptr) {
+		if native != 7 {
+			t.Fatalf("released unexpected native font %d", native)
+		}
+		released++
+	})
+	for _, font := range pending {
+		fonts.dead.add(font)
+	}
+	fonts.releaseDead(func(uintptr) { t.Fatal("late cleanup released an owner twice") })
+	fonts.closeFonts(func(uintptr) { t.Fatal("repeated shutdown released an owner twice") })
+	if released != 2 || len(fonts.dead.owned) != 0 || len(fonts.dead.native) != 0 {
+		t.Fatalf("released %d references; retained %d owners and %d queued callbacks", released, len(fonts.dead.owned), len(fonts.dead.native))
+	}
+	runtime.KeepAlive(first)
+	runtime.KeepAlive(second)
+}
+
+func TestNativeFontsConcurrentLateCleanup(t *testing.T) {
+	var fonts nativeFonts
+	const count = 256
+	keep := make([]*Font, count)
+	for index := range keep {
+		keep[index] = &Font{native: uintptr(index + 1)}
+		fonts.own(keep[index])
+	}
+	var pending []*ownedFont
+	for font := range fonts.dead.owned {
+		pending = append(pending, font)
+	}
+	start := make(chan struct{})
+	var callbacks sync.WaitGroup
+	for _, font := range pending {
+		callbacks.Go(func() {
+			<-start
+			fonts.dead.add(font)
+		})
+	}
+	close(start)
+	released := map[uintptr]int{}
+	fonts.closeFonts(func(native uintptr) { released[native]++ })
+	callbacks.Wait()
+	fonts.releaseDead(func(uintptr) { t.Fatal("shutdown left an unreleased queued callback") })
+	if len(released) != count {
+		t.Fatalf("released %d of %d owners", len(released), count)
+	}
+	for native, count := range released {
+		if count != 1 {
+			t.Fatalf("font %d released %d times", native, count)
+		}
+	}
+	runtime.KeepAlive(keep)
+}
+
+func TestNativeFontsNormalRetirementBeforeShutdown(t *testing.T) {
+	var fonts nativeFonts
+	keep := &Font{native: 19}
+	fonts.own(keep)
+	for font := range fonts.dead.owned {
+		fonts.dead.add(font)
+	}
+	released := 0
+	fonts.releaseDead(func(uintptr) { released++ })
+	fonts.closeFonts(func(uintptr) { t.Fatal("retired reference was released twice") })
+	if released != 1 {
+		t.Fatalf("normal retirement released %d references", released)
+	}
+	runtime.KeepAlive(keep)
+}
