+package mygo
+
+import "errors"
+
+// ShutdownNative releases platform resources after Run has returned and
+// all native clients have stopped. It must run on the main goroutine.
+// Shutdown is terminal and repeated calls are harmless. Platforms without
+// explicit native shutdown keep their existing process-lifetime behavior.
+func (a *Application) ShutdownNative() error {
+	if !isMainThread() {
+		return errors.New("mygo: native shutdown must run on the main goroutine")
+	}
+	if !a.initialized {
+		return nil
+	}
+	if !a.ended {
+		return errors.New("mygo: native shutdown requires App.Run to have returned")
+	}
+	if shutdown, ok := backend().(interface{ ShutdownNative() error }); ok {
+		return shutdown.ShutdownNative()
+	}
+	return nil
+}
