+func TestVariantBusErrorConsumesOnlyFloatingParameters(t *testing.T) {
+	for _, state := range []string{"floating", "borrowed", "absent"} {
+		t.Run(state, func(t *testing.T) {
+			stubVariants(t)
+			previousBus, previousSink := gBusGetSync, gVariantRefSink
+			t.Cleanup(func() { gBusGetSync, gVariantRefSink = previousBus, previousSink })
+			sessionBus = 0
+			message := cs("injected bus failure")
+			nativeError := struct {
+				domain  uint32
+				code    int32
+				message *byte
+			}{1, 1, message}
+			gBusGetSync = func(_ int32, _ ptr, failure *ptr) ptr {
+				*failure = ptr(uintptr(unsafe.Pointer(&nativeError)))
+				return 0
+			}
+			parameters := ptr(10)
+			if state == "absent" {
+				parameters = 0
+			}
+			references, sinks := 1, 0
+			gVariantRefSink = func(value ptr) ptr {
+				if value != parameters || value == 0 {
+					t.Fatalf("unexpected parameter sink %d", value)
+				}
+				sinks++
+				if state == "borrowed" {
+					references++
+				}
+				return value
+			}
+			gVariantUnref = func(value ptr) {
+				if value != parameters || value == 0 {
+					t.Fatalf("unexpected parameter release %d", value)
+				}
+				references--
+			}
+			if _, err := dbusCall("name", "/path", "interface", "method", parameters, ""); err == nil {
+				t.Fatal("session bus failure was ignored")
+			}
+			wantReferences, wantSinks := 1, 1
+			if state == "floating" {
+				wantReferences = 0
+			}
+			if state == "absent" {
+				wantSinks = 0
+			}
+			if references != wantReferences || sinks != wantSinks {
+				t.Fatalf("parameter ownership left %d references and %d sink calls", references, sinks)
+			}
+			runtime.KeepAlive(nativeError)
+		})
+	}
+}
