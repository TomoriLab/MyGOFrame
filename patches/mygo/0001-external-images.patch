+func stubVariants(t *testing.T) *variantLedger {
+	t.Helper()
+	oldTypeNew, oldTypeFree := gVariantTypeNew, gVariantTypeFree
+	oldArray, oldString, oldTuple := gVariantNewArray, gVariantNewString, gVariantNewTuple
+	oldCall, oldLookup, oldChild := gDBusConnectionCallSync, gVariantLookupValue, gVariantGetChildValue
+	oldUnref, oldErrorFree := gVariantUnref, gErrorFree
+	oldBus, oldRegistered := sessionBus, portalRegistered
+	oldUint32, oldInt32, oldGetUint32 := gVariantNewUint32, gVariantNewInt32, gVariantGetUint32
+	oldBoolean, oldVariant, oldEntry := gVariantNewBoolean, gVariantNewVariant, gVariantNewDictEntry
+	oldSubscribed, oldBackend := notifySubscribed, theBackend
+	oldNotifications, oldIdentifiers := notifications, notifyDBusIDs
+	t.Cleanup(func() {
+		gVariantTypeNew, gVariantTypeFree = oldTypeNew, oldTypeFree
+		gVariantNewArray, gVariantNewString, gVariantNewTuple = oldArray, oldString, oldTuple
+		gDBusConnectionCallSync, gVariantLookupValue, gVariantGetChildValue = oldCall, oldLookup, oldChild
+		gVariantUnref, gErrorFree = oldUnref, oldErrorFree
+		sessionBus, portalRegistered = oldBus, oldRegistered
+		gVariantNewUint32, gVariantNewInt32, gVariantGetUint32 = oldUint32, oldInt32, oldGetUint32
+		gVariantNewBoolean, gVariantNewVariant, gVariantNewDictEntry = oldBoolean, oldVariant, oldEntry
+		notifySubscribed, theBackend = oldSubscribed, oldBackend
+		notifications, notifyDBusIDs = oldNotifications, oldIdentifiers
+	})
+	ledger := &variantLedger{live: make(map[ptr]bool)}
+	gVariantTypeNew = func(*byte) ptr {
+		ledger.created++
+		value := ptr(ledger.created)
+		ledger.live[value] = true
+		return value
+	}
+	gVariantTypeFree = func(value ptr) {
+		if !ledger.live[value] {
+			t.Fatalf("type %d freed without one live owner", value)
+		}
+		delete(ledger.live, value)
+		ledger.freed++
+	}
+	gVariantNewArray = func(value ptr, _ unsafe.Pointer, length uintptr) ptr {
+		if value != 0 && !ledger.live[value] {
+			t.Fatal("array borrowed a released type")
+		}
+		if length == 0 {
+			ledger.emptyArrays++
+		}
+		return 100
+	}
+	gVariantNewString = func(*byte) ptr { return 101 }
+	gVariantNewTuple = func(unsafe.Pointer, uintptr) ptr { return 102 }
+	gVariantNewUint32 = func(uint32) ptr { return 103 }
+	gVariantNewInt32 = func(int32) ptr { return 104 }
+	gVariantNewBoolean = func(bool) ptr { return 105 }
+	gVariantNewVariant = func(ptr) ptr { return 106 }
+	gVariantNewDictEntry = func(ptr, ptr) ptr { return 107 }
+	gVariantGetUint32 = func(ptr) uint32 { return 5 }
+	gVariantGetChildValue = func(ptr, uintptr) ptr { return 108 }
+	gVariantUnref = func(ptr) {}
+	gErrorFree = func(ptr) {}
+	gVariantLookupValue = func(_ ptr, _ *byte, expected ptr) ptr {
+		if expected != 0 && !ledger.live[expected] {
+			t.Fatal("lookup borrowed a released type")
+		}
+		return 0
+	}
+	gDBusConnectionCallSync = func(_ ptr, _, _, _, _ *byte, _ ptr, expected ptr, _ int32, _ int32, _ ptr, _ *ptr) ptr {
+		if expected != 0 && !ledger.live[expected] {
+			t.Fatal("D-Bus call borrowed a released type")
+		}
+		return 109
+	}
+	sessionBus, portalRegistered, notifySubscribed = 500, true, true
+	theBackend = &Backend{}
+	notifications, notifyDBusIDs = make(map[uint32]string), make(map[string]uint32)
+	return ledger
+}
