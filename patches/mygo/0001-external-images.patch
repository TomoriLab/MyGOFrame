+package gl
+
+import (
+	"sync/atomic"
+	"weak"
+
+	"github.com/egoist/mygo/internal/scene"
+)
+
+var lastExternalContextID atomic.Uint64
+
+type externalImageHooks struct {
+	texture func(*Renderer, *scene.Image) uintptr
+	ready   func(*Renderer, *scene.Image)
+	release func(*Renderer)
+	abandon func(*Renderer)
+	retire  func(*Renderer)
+}
+
+var activeExternalImageHooks *externalImageHooks
+
+// EnableExternalImages links external providers only into applications that opt
+// into their constructor or GPU-ready instrumentation. It runs on the UI thread.
+func EnableExternalImages() {
+	if activeExternalImageHooks == nil {
+		activeExternalImageHooks = &externalImageHooks{
+			texture: (*Renderer).externalImageTexture,
+			ready:   (*Renderer).externalImageReady,
+			release: (*Renderer).releaseExternalImages,
+			abandon: (*Renderer).abandonExternalImages,
+			retire:  (*Renderer).releaseRetiredExternalImages,
+		}
+	}
+}
+
+func (r *Renderer) externalID() uint64 {
+	if r.externalContextID == 0 {
+		r.externalContextID = lastExternalContextID.Add(1)
+	}
+	return r.externalContextID
+}
+
+func (r *Renderer) externalImageReady(image *scene.Image) {
+	image.GPUReady(r.externalID())
+}
+
+func (r *Renderer) externalImageTexture(image *scene.Image) uintptr {
+	if image.W > r.maxSize || image.H > r.maxSize {
+		return 0
+	}
+	if r.externalImages == nil {
+		r.externalImages = make(map[uint64]externalTexture)
+	}
+	if _, present := r.externalImages[image.ID()]; !present {
+		r.externalImages[image.ID()] = externalTexture{provider: image.External, image: weak.Make(image)}
+	}
+	texture := image.External.Texture(r.externalID())
+	if texture != 0 && image.GPUReady != nil {
+		r.externalImageReady(image)
+	}
+	return uintptr(texture)
+}
