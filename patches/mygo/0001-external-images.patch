+package text
+
+// Shutdown permanently stops this text system. Callers must first stop
+// its windows and background text users. The System lock also serializes
+// a preload started before window teardown. A delayed preload then uses
+// the fontless engine instead of reopening native resources.
+func (s *System) Shutdown() {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closed {
+		return
+	}
+	s.closed = true
+	previous := s.eng
+	s.eng = &stubEngine{}
+	s.gen++
+	s.familiesGen++
+	s.families, s.listed = nil, false
+	s.clearLayouts()
+	clear(s.fonts)
+	clear(s.marks)
+	clear(s.glyphs)
+	clear(s.places)
+	clear(s.runs)
+	clear(s.masks)
+	clear(s.transient)
+	clear(s.recent)
+	clear(s.outGlyphs)
+	clear(s.outRuns)
+	clear(s.outMasks)
+	if engine, ok := previous.(interface{ shutdown() }); ok {
+		engine.shutdown()
+	}
+}
