+//go:build linux && (amd64 || arm64)
+
+package linux
+
+import (
+	"fmt"
+	"reflect"
+	"testing"
+)
+
+func TestNativeShutdownDisconnectsOwnedSignalsBeforeDisplayClose(t *testing.T) {
+	calls := stubNativeShutdown(t)
+	previousReference, previousUnref := gObjectRef, gObjectUnref
+	previousConnect, previousDisconnect := gSignalConnectData, gSignalHandlerDisconnect
+	t.Cleanup(func() {
+		gObjectRef, gObjectUnref = previousReference, previousUnref
+		gSignalConnectData, gSignalHandlerDisconnect = previousConnect, previousDisconnect
+	})
+	var nextHandler uint64
+	gObjectRef = func(object ptr) ptr { return object }
+	gSignalConnectData = func(instance ptr, signal *byte, callback ptr, data ptr, destroy ptr, flags int32) uint64 {
+		nextHandler++
+		return nextHandler
+	}
+	gSignalHandlerDisconnect = func(instance ptr, handler uint64) {
+		*calls = append(*calls, fmt.Sprintf("disconnect:%d:%d", instance, handler))
+	}
+	gObjectUnref = func(instance ptr) { *calls = append(*calls, fmt.Sprintf("unref:%d", instance)) }
+	backend := New()
+	backend.connectSystemSignal(31, "notify::first", 1)
+	backend.connectSystemSignal(31, "notify::second", 2)
+	backend.connectSystemSignal(47, "device-removed", 3)
+	if err := backend.shutdownNative(); err != nil {
+		t.Fatal(err)
+	}
+	if err := backend.shutdownNative(); err != nil {
+		t.Fatal(err)
+	}
+	expected := []string{"disconnect:31:1", "disconnect:31:2", "disconnect:47:3", "unref:31", "unref:31", "unref:47", "clear", "close"}
+	if !reflect.DeepEqual(*calls, expected) || len(backend.systemSignals) != 0 {
+		t.Fatalf("observer cleanup order %v, expected %v", *calls, expected)
+	}
+}
+
+func TestNativeShutdownBalancesFailedAndMissingSignalOwners(t *testing.T) {
+	previousReference, previousUnref, previousConnect := gObjectRef, gObjectUnref, gSignalConnectData
+	t.Cleanup(func() {
+		gObjectRef, gObjectUnref, gSignalConnectData = previousReference, previousUnref, previousConnect
+	})
+	var references, releases, connections int
+	gObjectRef = func(object ptr) ptr { references++; return object }
+	gObjectUnref = func(object ptr) { releases++ }
+	gSignalConnectData = func(instance ptr, signal *byte, callback ptr, data ptr, destroy ptr, flags int32) uint64 {
+		connections++
+		return 0
+	}
+	backend := New()
+	backend.connectSystemSignal(0, "missing", 1)
+	backend.connectSystemSignal(31, "failed", 1)
+	if references != 1 || releases != 1 || connections != 1 || len(backend.systemSignals) != 0 {
+		t.Fatalf("unbalanced observer owners: references=%d releases=%d connections=%d retained=%d", references, releases, connections, len(backend.systemSignals))
+	}
+}
+
+func stubNativeShutdown(t *testing.T) *[]string {
+	t.Helper()
+	previousDisplay, previousClose, previousCurrent := gdkDisplayGetDefault, gdkDisplayClose, gdkGLContextClearCurrent
+	t.Cleanup(func() {
+		gdkDisplayGetDefault, gdkDisplayClose, gdkGLContextClearCurrent = previousDisplay, previousClose, previousCurrent
+	})
+	calls := new([]string)
+	gdkDisplayGetDefault = func() ptr { return 17 }
+	gdkGLContextClearCurrent = func() { *calls = append(*calls, "clear") }
+	gdkDisplayClose = func(display ptr) {
+		if display != 17 {
+			t.Fatalf("closed foreign display %d", display)
+		}
+		*calls = append(*calls, "close")
+	}
+	return calls
+}
+
+func TestNativeShutdownClosesDisplayOnceAfterClearingContext(t *testing.T) {
+	calls := stubNativeShutdown(t)
+	backend := New()
+	if err := backend.shutdownNative(); err != nil {
+		t.Fatal(err)
+	}
+	if err := backend.shutdownNative(); err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(*calls, []string{"clear", "close"}) {
+		t.Fatalf("native cleanup order %v", *calls)
+	}
+}
+
+func TestNativeShutdownRejectsActiveOwners(t *testing.T) {
+	for name, backend := range map[string]*Backend{
+		"loop":    {running: true},
+		"window":  {windows: map[int]*window{1: {}}},
+		"webview": {webViews: map[int]*window{1: {}}},
+		"tray":    {trays: map[int]*tray{1: {}}},
+		"modal":   {modals: []modal{{}}},
+		"popup":   {popups: []ptr{1}},
+	} {
+		t.Run(name, func(t *testing.T) {
+			calls := stubNativeShutdown(t)
+			gdkDisplayGetDefault = func() ptr { t.Fatal("native display accessed before clients stopped"); return 0 }
+			if err := backend.shutdownNative(); err == nil {
+				t.Fatal("active native owner was ignored")
+			}
+			if backend.nativeClosed || len(*calls) != 0 {
+				t.Fatal("rejected shutdown changed native state")
+			}
+		})
+	}
+}
