+func TestVariantReplyTypeReleasedOnCallError(t *testing.T) {
+	ledger := stubVariants(t)
+	message := cs("injected call failure")
+	nativeError := struct {
+		domain  uint32
+		code    int32
+		message *byte
+	}{1, 1, message}
+	gDBusConnectionCallSync = func(_ ptr, _, _, _, _ *byte, _ ptr, expected ptr, _ int32, _ int32, _ ptr, failure *ptr) ptr {
+		if !ledger.live[expected] {
+			t.Fatal("type released before call error completed")
+		}
+		*failure = ptr(uintptr(unsafe.Pointer(&nativeError)))
+		return 0
+	}
+	if _, err := dbusCall("name", "/path", "interface", "method", 0, "(u)"); err == nil {
+		t.Fatal("native error not propagated")
+	}
+	runtime.KeepAlive(nativeError)
+	requireReleased(t, ledger, 1)
+}
