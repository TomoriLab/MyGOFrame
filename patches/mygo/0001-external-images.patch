+// ExternalImage supplies a premultiplied RGBA GL_TEXTURE_2D in the current
+// OpenGL renderer context. Texture and Release run on the UI thread with that
+// context current. The provider must restore every GL state it changes,
+// including the framebuffer, before returning. The renderer borrows the texture.
+// Context identifiers are unique for each renderer context lifetime.
+//
+// A provider retaining native resources must also implement Abandon(uint64).
+// That optional method releases non-GL ownership after unexpected context loss;
+// it must not delete texture names belonging to the lost context.
+// External images currently require the OpenGL renderer. Applications retain
+// responsibility for a CPU fallback when that renderer is unavailable.
+type ExternalImage interface {
+	Texture(contextID uint64) uint32
+	Release(contextID uint64)
+}
+
+// NewExternalBitmap preserves GPU ownership without allocating CPU RGBA pixels.
+// Its methods follow Bitmap.Update's main-thread requirement.
+func NewExternalBitmap(width, height int, provider ExternalImage) *Bitmap {
+	if width <= 0 || height <= 0 || provider == nil {
+		panic("ui: external bitmap requires positive dimensions and a provider")
+	}
+	enableExternalImageBackend()
+	return &Bitmap{img: scene.NewExternalImage(width, height, provider), w: width, h: height}
+}
+
+// InvalidateExternal marks newly prepared external content for partial redraw.
+func (b *Bitmap) InvalidateExternal() {
+	if b != nil && b.img.External != nil {
+		b.img.Changed()
+	}
+}
+
+// ReleaseExternal retires the provider before scenes stop referencing its image.
+// Each renderer releases its resources on its next frame or context teardown.
+func (b *Bitmap) ReleaseExternal() {
+	if b != nil && b.img.External != nil {
+		b.img.External = nil
+		b.img.Changed()
+	}
+}
+
+// SetGPUReadyCallback observes an uploaded or externally prepared image before
+// UI compositing. It runs with the renderer context current and must preserve GL
+// state. It may run repeatedly for an unchanged image or in several contexts.
+func (b *Bitmap) SetGPUReadyCallback(callback func(contextID uint64)) {
+	if b == nil {
+		return
+	}
+	if callback != nil {
+		enableExternalImageBackend()
+	}
+	b.gpuReady, b.img.GPUReady = callback, callback
+	for _, level := range b.levels {
+		level.GPUReady = callback
+	}
+}
