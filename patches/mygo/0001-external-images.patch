+
+func (b *Backend) connectSystemSignal(instance ptr, signal string, callback ptr) {
+	if instance == 0 {
+		return
+	}
+	// The observer owns a reference because seats may disappear before terminal shutdown.
+	owner := gObjectRef(instance)
+	handler := connect(owner, signal, callback, 0)
+	if handler == 0 {
+		gObjectUnref(owner)
+		return
+	}
+	b.systemSignals = append(b.systemSignals, nativeSystemSignal{owner, handler})
+}
+
+func (b *Backend) disconnectSystemSignals() {
+	signals := b.systemSignals
+	b.systemSignals = nil
+	// Every callback stops before releasing any object can emit another native signal.
+	for _, signal := range signals {
+		gSignalHandlerDisconnect(signal.instance, signal.handler)
+	}
+	for _, signal := range signals {
+		gObjectUnref(signal.instance)
+	}
+}
 
