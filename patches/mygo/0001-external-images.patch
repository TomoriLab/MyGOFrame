+type shutdownEngine struct {
+	stubEngine
+	started chan struct{}
+	resume  chan struct{}
+	closed  int
+}
+
+func (engine *shutdownEngine) font(style Style) *Font {
+	close(engine.started)
+	<-engine.resume
+	return engine.stubEngine.font(style)
+}
+
+func (engine *shutdownEngine) shutdown() { engine.closed++ }
+
+func TestShutdownSerializesPreloadAndStaysClosed(t *testing.T) {
+	system := newSystem()
+	engine := &shutdownEngine{started: make(chan struct{}), resume: make(chan struct{})}
+	system.eng = engine
+	preloaded := make(chan struct{})
+	go func() {
+		system.Preload()
+		close(preloaded)
+	}()
+	<-engine.started
+	stopped := make(chan struct{})
+	go func() {
+		system.Shutdown()
+		close(stopped)
+	}()
+	close(engine.resume)
+	<-preloaded
+	<-stopped
+	if engine.closed != 1 {
+		t.Fatalf("native engine shut down %d times", engine.closed)
+	}
+	generation := system.Generation()
+	system.Preload()
+	system.Shape(Params{Text: "after shutdown"})
+	system.Shutdown()
+	if engine.closed != 1 || generation != system.Generation() {
+		t.Fatal("repeated shutdown changed terminal state")
+	}
+	if _, ok := system.eng.(*stubEngine); !ok {
+		t.Fatal("delayed text work reopened a native engine")
+	}
+}
+
+func TestShutdownWithoutNativeEngine(t *testing.T) {
+	system := newSystem()
+	system.Shutdown()
+	system.Preload()
+	if _, ok := system.eng.(*stubEngine); !ok {
+		t.Fatal("unused text shutdown initialized a native engine")
+	}
+}
