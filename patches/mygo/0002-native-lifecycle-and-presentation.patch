+//go:build linux && (amd64 || arm64)
+
+package linux
+
+import "testing"
+
+func TestGLFrameTextureSelection(t *testing.T) {
+	for _, scenario := range []struct {
+		transparent bool
+		api         string
+		texture     bool
+	}{{false, "gles", true}, {false, "GLES", true}, {true, "", true}, {false, "", false}} {
+		if got := glAreaNeedsTexture(scenario.transparent, scenario.api); got != scenario.texture {
+			t.Fatalf("transparency=%v API=%q selected texture=%v", scenario.transparent, scenario.api, got)
+		}
+	}
+}
+
+func TestGLFrameRequestsCoalesceBeforePaint(t *testing.T) {
+	previousError, previousTick, previousQueue := gtkGLAreaGetError, gtkWidgetAddTickCallback, gtkGLAreaQueueRender
+	t.Cleanup(func() {
+		gtkGLAreaGetError, gtkWidgetAddTickCallback, gtkGLAreaQueueRender = previousError, previousTick, previousQueue
+	})
+	gtkGLAreaGetError = func(ptr) ptr { return 0 }
+	var ticks, draws int
+	gtkWidgetAddTickCallback = func(widget, callback, data, notify ptr) uint32 { ticks++; return uint32(ticks) }
+	gtkGLAreaQueueRender = func(ptr) { draws++ }
+	first := &surface{w: &window{id: 1}, gl: true, drawn: true}
+	second := &surface{w: &window{id: 2}, gl: true, drawn: true}
+	for range 4 {
+		first.RequestFrame()
+		second.RequestFrame()
+	}
+	if ticks != 2 || draws != 0 {
+		t.Fatalf("requests bypassed update: ticks=%d draws=%d", ticks, draws)
+	}
+	if !first.renderQueuedFrame() || !second.renderQueuedFrame() || draws != 2 {
+		t.Fatal("update did not consume each window's request")
+	}
+	first.RequestFrame()
+	if ticks != 2 || !first.renderQueuedFrame() || draws != 3 {
+		t.Fatal("streaming requests replaced the live update source")
+	}
+	if first.renderQueuedFrame() || second.renderQueuedFrame() || first.renderPending || second.renderPending || draws != 3 {
+		t.Fatal("idle update redrew or retained its source")
+	}
+	first.RequestFrame()
+	if ticks != 3 {
+		t.Fatal("request after idle could not schedule an update")
+	}
+	first.w.closed = true
+	if first.renderQueuedFrame() {
+		t.Fatal("closed window retained an update")
+	}
+	first.RequestFrame()
+	if draws != 3 || ticks != 3 {
+		t.Fatal("closed window scheduled native work")
+	}
+	second.rendering = true
+	second.RequestFrame()
+	if !second.renderAgain || second.renderPending || ticks != 3 {
+		t.Fatal("request during rendering was not deferred")
+	}
+}
